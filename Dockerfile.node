# Stage 1: Install production dependencies
FROM node:24.16.0-slim AS deps
WORKDIR /app/ws-server
COPY ws-server/package*.json ./
RUN npm ci --omit=dev

# Stage 2: Build final production image
FROM node:24.16.0-slim
WORKDIR /app/ws-server
COPY --from=deps /app/ws-server/node_modules ./node_modules
COPY ws-server/ ./
EXPOSE 988 3111

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:19880/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1) }).on('error', () => process.exit(1))"

CMD ["npm", "start"]
